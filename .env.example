# ========================================================
# IIIT Bhubaneswar Mess Management System Environment Config
# ========================================================

# Server Port (PaaS platforms like Render/Railway/Heroku inject this automatically)
PORT=5000

# Application Environment (production / development)
NODE_ENV=production

# Persistent storage directory for database.json (Leave empty for default local folder)
DATA_DIR=

# Custom path to static frontend build (Optional, defaults to ../client/dist)
CLIENT_DIST=
